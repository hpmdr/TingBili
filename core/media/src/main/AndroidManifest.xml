<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 播放服务与其实现同模块：前台 Service 声明随 core:media 合并进最终包 -->
    <application>
        <service
            android:name="cn.debubu.tingbili.core.media.TingBiliPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 硬件媒体键（耳机/蓝牙）：服务未起时由 media3 收到 MEDIA_BUTTON 再拉起服务 -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
            睡眠定时到点（AlarmManager allow-while-idle）：
            纯协程 delay 走 uptime，Doze + DSP offload 下整夜不执行，必须由系统闹钟投递。
            静态注册才能在进程被回收后把 App 拉起来执行暂停。
        -->
        <receiver
            android:name="cn.debubu.tingbili.core.media.SleepTimerAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="cn.debubu.tingbili.action.SLEEP_TIMER_ALARM" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
